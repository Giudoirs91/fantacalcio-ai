{
  "version": 2,
  "name": "fantamasterai",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,

  "functions": {
    "api/*.py": {
      "excludeFiles": "{dist/**,Dashboard_Fanta_1000.html}"
    }
  },

  "rewrites": [
    {
      "source": "/api/track",
      "destination": "/api/track.py"
    },
    {
      "source": "/api/stats",
      "destination": "/api/stats.py"
    },
    {
      "source": "/calciatore/:slug",
      "destination": "/calciatore/:slug/index.html"
    },
    {
      "source": "/probabili-formazioni/:team",
      "destination": "/probabili-formazioni/:team/index.html"
    }
  ],

  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
