{
  "version": 2,
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,

  "functions": {
    "api/*.py": {
      "excludeFiles": "{dist/**,Dashboard_Fanta_1000.html}"
    }
  },

  "redirects": [
    {
      "source": "/calciatore/ciss",
      "destination": "/calciatore/cisse-a/",
      "permanent": true
    },
    {
      "source": "/calciatore/traor",
      "destination": "/calciatore/traore-hj/",
      "permanent": true
    },
    {
      "source": "/calciatore/z",
      "destination": "/calciatore/ze-pedro/",
      "permanent": true
    },
    {
      "source": "/calciatore/wiafe",
      "destination": "/probabili-formazioni/",
      "permanent": true
    },
    {
      "source": "/calciatore/:slug-2026",
      "destination": "/calciatore/:slug/",
      "permanent": true
    },
    {
      "source": "/calciatore/:slug(.*)-2026",
      "destination": "/calciatore/:slug/",
      "permanent": true
    },
    {
      "source": "/calciatore/:slug(.*)-:id(\\d{4})",
      "destination": "/calciatore/:slug/",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/api/track",
      "destination": "/api/track.py"
    },
    {
      "source": "/api/stats",
      "destination": "/api/stats.py"
    },
    {
      "source": "/calciatore/:slug",
      "destination": "/calciatore/:slug/index.html"
    },
    {
      "source": "/probabili-formazioni/:team",
      "destination": "/probabili-formazioni/:team/index.html"
    }
  ],

  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
