{
  "version": 2,
  "outputDirectory": "dist",

  "routes": [
    {
      "src": "/api/track",
      "dest": "/api/track.py"
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.py"
    },
    {
      "src": "/calciatore/([^/]+)(/index\\.html)?",
      "dest": "/calciatore/$1/index.html"
    },
    {
      "src": "/top-flop(/index\\.html)?",
      "dest": "/top-flop/index.html"
    },
    {
      "src": "/consigli-fantacalcio(/index\\.html)?",
      "dest": "/consigli-fantacalcio/index.html"
    },
    {
      "src": "/football-analytics(/index\\.html)?",
      "dest": "/football-analytics/index.html"
    },
    {
      "src": "/statistiche-serie-a(/index\\.html)?",
      "dest": "/statistiche-serie-a/index.html"
    },
    {
      "src": "/probabili-formazioni(/index\\.html)?",
      "dest": "/probabili-formazioni/index.html"
    },
    {
      "src": "/confronto-calciatori(/index\\.html)?",
      "dest": "/confronto-calciatori/index.html"
    },
    {
      "src": "/top-11-ai(/index\\.html)?",
      "dest": "/top-11-ai/index.html"
    },
    {
      "src": "/scommesse-talenti(/index\\.html)?",
      "dest": "/scommesse-talenti/index.html"
    },
    {
      "src": "/griglia-portieri(/index\\.html)?",
      "dest": "/griglia-portieri/index.html"
    },
    {
      "src": "/infortunati-serie-a(/index\\.html)?",
      "dest": "/infortunati-serie-a/index.html"
    },
    {
      "src": "/rigoristi-serie-a(/index\\.html)?",
      "dest": "/rigoristi-serie-a/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],

  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
